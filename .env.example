# Provider: openai | ollama | mock
KERNELIS_PROVIDER=ollama
KERNELIS_MODEL=qwen2.5-coder:14b
KERNELIS_BASE_URL=http://localhost:11434/v1
KERNELIS_API_KEY=ollama

# Execution Policy: safe | confirm | autonomous
KERNELIS_POLICY=confirm

# Execution limits
KERNELIS_COMMAND_TIMEOUT=60
KERNELIS_MAX_RETRIES=2
KERNELIS_WORKDIR=.
KERNELIS_LOG_LEVEL=INFO
